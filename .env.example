# Token do Bot do Discord (obtido na aba "Bot" no Discord Developer Portal)
DISCORD_TOKEN=

# Application ID (Client ID) do Bot (obtido na aba "General Information")
CLIENT_ID=

# ID do canal onde o bot irá responder ativamente (ative o Modo Desenvolvedor no Discord e clique com botão direito no canal -> Copiar ID)
TARGET_CHANNEL_ID=

# Chave de API do Google Gemini (gratuita em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Modelos do Google Gemini (Principal e Fallback)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# ID do usuário alvo para Auto-Aprendizado contínuo (Jinchi)
CRAWL_USER_ID=264201832492957698

# Modo Introsa: Chance de responder mensagens soltas no canal alvo
# Aceita porcentagem (5%, 10%, 25%, 50%) ou decimal (0.05, 0.10, 0.25, 0.50). 0 ou 0% desativa.
# Exemplo: 0.05 ou 5% para responder a cada ~20 mensagens humanas.
# Nota: Quando alguém menciona o bot (@Dubinha) ou responde (Reply) a ele, ele SEMPRE responde (100%).
REPLY_PROBABILITY=0.05

# Tempo mínimo em segundos de intervalo (cooldown) entre respostas espontâneas no mesmo canal
COOLDOWN_SECONDS=25

# Mínimo de mensagens humanas antes de poder se intrometer sozinho
MIN_HUMAN_MESSAGES=1

